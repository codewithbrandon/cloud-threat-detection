# Prevent sensitive files from entering the build context
.env
.env.*
*.env
secrets/
credentials/
*.pem
*.key
*.crt
*.p12

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Development artifacts
.git/
.gitignore
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# Documentation (not needed in image)
docs/
*.md
README*

# IDE configs
.vscode/
.idea/
*.swp
*.swo
